{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "cases-{season}.json 三赛季判例数据契约（season 键可选：2025 为管线改版前的人工精修存档，无此键属历史形态，见 tests/test_golden_parsers.py 的看护说明）",
  "type": "object",
  "required": ["issues", "cases"],
  "properties": {
    "season": {"enum": ["2024", "2025", "2026"]},
    "issues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["no", "title", "url", "date", "summary",
                     "expected_wrong", "parsed_wrong", "video_count"],
        "properties": {
          "no": {"type": "integer"},
          "title": {"type": "string", "minLength": 1},
          "url": {"type": "string", "pattern": "^https://"},
          "date": {"type": "string", "pattern": "^\\d{8}$"},
          "summary": {"type": "string"},
          "expected_wrong": {"type": "integer"},
          "parsed_wrong": {"type": "integer"},
          "video_count": {"type": "integer"}
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["seq", "issue", "no", "desc", "appeal", "conclusion",
                     "match_info", "comp", "round", "home", "away", "minute",
                     "referee_verdict", "var_verdict", "video_files", "video_urls",
                     "category", "category_name", "tags",
                     "referee_verdict_name", "var_verdict_name"],
        "properties": {
          "seq": {"type": "integer"},
          "issue": {"type": "integer"},
          "no": {"type": "integer"},
          "desc": {"type": "string", "minLength": 1},
          "appeal": {"type": "string"},
          "conclusion": {"type": "string"},
          "match_info": {"type": "string"},
          "comp": {"type": "string"},
          "round": {"type": "string"},
          "home": {"type": "string"},
          "away": {"type": "string"},
          "minute": {"type": "string"},
          "referee_verdict": {"enum": ["wrong", "correct", "pending"]},
          "var_verdict": {"enum": ["correct", "wrong", "none"]},
          "video_files": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "video_urls": {"type": "array", "items": {"type": "string", "pattern": "^https://"}},
          "category": {"enum": ["handball", "offside", "penalty_area", "freekick_foul",
                                "spa_tactical", "dogso", "sfp_vc", "simulation",
                                "goal_decision", "other_program"]},
          "category_name": {"type": "string"},
          "tags": {"type": "array", "items": {"type": "string"}},
          "referee_verdict_name": {"enum": ["错漏判", "支持原判", "不予认定"]},
          "var_verdict_name": {"type": "string"}
        }
      }
    }
  }
}
