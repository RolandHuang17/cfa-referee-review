{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CONMEBOL 官方文章与逐案详情",
  "description": "每篇文章按正文顺序列出情境及同段各语言视频。顶层分钟、情境及视频为首场景兼容字段。旧版身份冲突的待核记录保留独立契约。",
  "type": "object",
  "required": [
    "source",
    "source_name",
    "fetched",
    "cases"
  ],
  "properties": {
    "source": {
      "type": "string",
      "minLength": 1
    },
    "source_name": {
      "type": "string",
      "minLength": 1
    },
    "fetched": {
      "type": "string"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "url",
          "title",
          "date",
          "match",
          "situacion_norm"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "date": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https://www\\.conmebol\\.com/noticias/[^\\s?#]+/$"
          },
          "match": {
            "type": "string",
            "minLength": 1
          },
          "comp": {
            "type": "string"
          },
          "comp_cn": {
            "type": "string"
          },
          "excerpt_es": {
            "type": "string"
          },
          "fecha": {
            "type": "string"
          },
          "ciudad": {
            "type": "string"
          },
          "estadio": {
            "type": "string"
          },
          "situacion_es": {
            "type": "string"
          },
          "minuto": {
            "type": "string"
          },
          "youtube": {
            "type": "string",
            "pattern": "^(?:$|https://www\\.youtube\\.com/watch\\?v=[A-Za-z0-9_-]{11}$)"
          },
          "situacion_norm": {
            "type": "string",
            "minLength": 1
          },
          "detail_status": {
            "enum": [
              "pending"
            ]
          },
          "unrelated_cache_url": {
            "type": "string",
            "pattern": "^https://www\\.conmebol\\.com/noticias/[^\\s?#]+/$"
          },
          "events": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "situacion_es",
                "situacion_norm",
                "minuto",
                "videos"
              ],
              "properties": {
                "situacion_es": {
                  "type": "string"
                },
                "situacion_norm": {
                  "type": "string",
                  "minLength": 1
                },
                "minuto": {
                  "type": "string"
                },
                "videos": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": [
                      "url",
                      "title",
                      "lang"
                    ],
                    "properties": {
                      "url": {
                        "type": "string",
                        "pattern": "^(?:https://www\\.youtube\\.com/watch\\?v=[A-Za-z0-9_-]{11}$)"
                      },
                      "title": {
                        "type": "string"
                      },
                      "lang": {
                        "enum": [
                          "",
                          "es",
                          "pt"
                        ]
                      }
                    }
                  }
                },
                "source_fields": {
                  "type": "object",
                  "required": [
                    "situacion_es",
                    "minuto"
                  ],
                  "properties": {
                    "situacion_es": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minuto": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "required": [
                "detail_status"
              ]
            },
            "then": {
              "required": [
                "unrelated_cache_url",
                "fecha",
                "ciudad",
                "estadio",
                "situacion_es",
                "minuto",
                "youtube"
              ],
              "properties": {
                "fecha": {
                  "enum": [
                    ""
                  ]
                },
                "ciudad": {
                  "enum": [
                    ""
                  ]
                },
                "estadio": {
                  "enum": [
                    ""
                  ]
                },
                "situacion_es": {
                  "enum": [
                    ""
                  ]
                },
                "minuto": {
                  "enum": [
                    ""
                  ]
                },
                "youtube": {
                  "enum": [
                    ""
                  ]
                },
                "situacion_norm": {
                  "enum": [
                    "other"
                  ]
                }
              },
              "oneOf": [
                {
                  "properties": {
                    "url": {
                      "const": "https://www.conmebol.com/noticias/situacion-de-analisis-var-eliminatorias-sudamericanas-bolivia-vs-brasil/"
                    },
                    "unrelated_cache_url": {
                      "const": "https://www.conmebol.com/noticias/situacion-de-analisis-var-eliminatorias-sudamericanas-bolivia-vs-brasil-2/"
                    }
                  }
                },
                {
                  "properties": {
                    "url": {
                      "const": "https://www.conmebol.com/noticias/situacion-de-analisis-var-conmebol-sudamericana-independiente-del-valle-vs-deportivo-tachira/"
                    },
                    "unrelated_cache_url": {
                      "const": "https://www.conmebol.com/noticias/situacion-de-analisis-var-conmebol-sudamericana-independiente-del-valle-vs-melgar/"
                    }
                  }
                },
                {
                  "properties": {
                    "url": {
                      "const": "https://www.conmebol.com/noticias/situacion-de-analisis-var-conmebol-sudamericana-independiente-del-valle-vs-lanus/"
                    },
                    "unrelated_cache_url": {
                      "const": "https://www.conmebol.com/noticias/situacion-de-analisis-var-conmebol-sudamericana-independiente-del-valle-vs-melgar/"
                    }
                  }
                },
                {
                  "properties": {
                    "url": {
                      "const": "https://www.conmebol.com/noticias/situacion-de-analisis-var-conmebol-sudamericana-atletico-goianiense-vs-nacional/"
                    },
                    "unrelated_cache_url": {
                      "const": "https://www.conmebol.com/noticias/situacion-de-analisis-var-conmebol-sudamericana-atletico-goianiense-vs-sao-paulo/"
                    }
                  }
                }
              ],
              "not": {
                "required": [
                  "events"
                ]
              }
            },
            "else": {
              "not": {
                "required": [
                  "unrelated_cache_url"
                ]
              },
              "required": [
                "events"
              ]
            }
          }
        ]
      }
    }
  }
}
