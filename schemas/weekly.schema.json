{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "weekly.json 全球周更评议节目索引契约",
  "type": "object",
  "required": ["source", "source_name", "fetched", "shows", "episodes"],
  "properties": {
    "source": {"type": "string"},
    "source_name": {"type": "string"},
    "fetched": {"type": "string"},
    "shows": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["name", "org", "lang", "update", "url"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "org": {"type": "string"},
          "lang": {"type": "string"},
          "update": {"type": "string"},
          "url": {"type": "string", "pattern": "^https?://"}
        }
      }
    },
    "episodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "show", "title", "url"],
        "properties": {
          "id": {"type": "string", "minLength": 5},
          "show": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "url": {"type": "string", "pattern": "^https?://"},
          "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}"},
          "date_src": {"enum": ["exact", "approx"]},
          "length": {"type": ["string", "integer"]},
          "views": {"type": ["integer", "null"]},
          "desc": {"type": "string"}
        }
      }
    }
  }
}
